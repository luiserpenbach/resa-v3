{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd web && npm ci && npm run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 2048,
      "excludeFiles": "{web/**,frontend/**,tests/**,docs/**,campaigns/**,scripts/**,out/**,workspace/**,.github/**,**/__pycache__/**,**/*.md}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/|assets/|favicon\\.svg).*)", "destination": "/index.html" }
  ]
}
